<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="?attr/colorPrimary">
    <TextView
        android:id="@+id/welcome_text"
        android:layout_width="250dp"
        android:layout_height="135dp"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toTopOf="@id/options_layout"
        app:layout_constraintRight_toRightOf="parent"
        android:textColor="?attr/colorOnPrimary"
        android:text="@string/welcome_text"
        android:gravity="center"
        app:layout_constraintVertical_chainStyle="spread"/>
    <LinearLayout
        android:id="@+id/options_layout"
        android:layout_width="300dp"
        android:layout_height="150dp"
        android:baselineAligned="false"
        app:layout_constraintTop_toBottomOf="@+id/welcome_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toTopOf="@id/next_button"
        android:orientation="horizontal"
        android:weightSum="100">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:orientation="vertical"
            android:gravity="start">
            <ImageButton
                android:id="@+id/flag_button"
                android:contentDescription="@string/flag_button"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:elevation="8dp"/>
            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/flags"
                android:gravity="center"
                android:layout_gravity="start"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="50"
            android:orientation="vertical"
            android:gravity="end">
            <ImageButton
                android:id="@+id/capitals_button"
                android:contentDescription="@string/flag_button"
                android:layout_width="120dp"
                android:elevation="8dp"
                android:layout_height="120dp"/>
            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="@string/capitals"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/next_button"
        android:layout_width="110dp"
        android:layout_height="45dp"
        android:background="@drawable/cta_button_background"
        android:elevation="8dp"
        android:text="@string/next"
        android:textColor="?attr/colorTertiary"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/options_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>