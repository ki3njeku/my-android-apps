<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="?attr/colorTertiary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        app:cardCornerRadius="10dp"
        android:background="?attr/colorPrimaryContainer"
        android:layout_width="300dp"
        android:layout_height="167dp"
        app:layout_constraintBottom_toTopOf="@id/canvas"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?attr/colorPrimaryContainer"
            android:weightSum="100">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="40"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/pallete"
                    android:contentDescription="@string/pallet_icon_name"/>

                <TextView
                    android:layout_width="180dp"
                    android:textColor="?attr/colorAccent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:text="@string/colors"
                    android:textSize="24sp" />
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="60">

                <com.example.paintapp.ColorSwitchingButton
                    android:id="@+id/occupied_1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toTopOf="@id/unoccupied_1"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/occupied_2"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread" />

                <com.example.paintapp.ColorSwitchingButton
                    android:id="@+id/unoccupied_1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/unoccupied_2"
                    app:layout_constraintTop_toBottomOf="@id/occupied_1" />

                <com.example.paintapp.ColorSwitchingButton
                    android:id="@+id/occupied_2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toTopOf="@id/unoccupied_2"
                    app:layout_constraintLeft_toRightOf="@id/occupied_1"
                    app:layout_constraintRight_toLeftOf="@id/occupied_3"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread" />

                <Button
                    android:id="@+id/unoccupied_2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/unoccupied_1"
                    app:layout_constraintRight_toLeftOf="@id/unoccupied_3"
                    app:layout_constraintTop_toBottomOf="@id/occupied_2" />

                <com.example.paintapp.ColorSwitchingButton
                    android:id="@+id/occupied_3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toTopOf="@id/unoccupied_3"
                    app:layout_constraintLeft_toRightOf="@id/occupied_2"
                    app:layout_constraintRight_toLeftOf="@id/occupied_4"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread" />

                <Button
                    android:id="@+id/unoccupied_3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/unoccupied_2"
                    app:layout_constraintRight_toLeftOf="@id/unoccupied_4"
                    app:layout_constraintTop_toBottomOf="@id/occupied_3" />

                <com.example.paintapp.ColorSwitchingButton
                    android:id="@+id/occupied_4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toTopOf="@id/unoccupied_4"
                    app:layout_constraintLeft_toRightOf="@+id/occupied_3"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread" />

                <Button
                    android:id="@+id/unoccupied_4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/color_button_background"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/unoccupied_3"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/occupied_4" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.example.paintapp.DrawingView
        android:id="@+id/canvas"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:background="@drawable/canvas_background"
        android:outlineAmbientShadowColor="?android:attr/shadowColor"
        android:outlineSpotShadowColor="?android:attr/shadowColor"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_menu"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:outlineAmbientShadowColor="?android:attr/shadowColor"
        android:outlineSpotShadowColor="?android:attr/shadowColor"
        android:background="@drawable/menu_background"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/canvas"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageButton
            android:id="@+id/brush_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/paintbrush_svgrepo_com"
            android:contentDescription="@string/brush_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/home_button"/>
        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/canvaslight"
            android:contentDescription="@string/home_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/brush_button"
            app:layout_constraintRight_toLeftOf="@id/options_button"/>
        <ImageButton
            android:id="@+id/options_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/hamburger_menu"
            android:contentDescription="@string/options_button"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toRightOf="@id/home_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>